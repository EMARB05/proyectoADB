<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0" style="-fx-background-color: #1e1e2e; -fx-padding: 0;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.View.AjustesController">

    <!-- CABECERA -->
    <HBox alignment="CENTER_LEFT" spacing="15"
          style="-fx-padding: 16 24 12 24; -fx-background-color: #1e1e2e;">
        <Button text="←" onAction="#onVolver"
                style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4;
                       -fx-cursor: hand; -fx-background-radius: 5;"/>
        <Label fx:id="lblTitulo" text="Gestión de Dispositivo"
               style="-fx-text-fill: #cdd6f4; -fx-font-size: 18px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- BARRA DE PESTAÑAS -->
    <HBox spacing="0" style="-fx-background-color: #181825;">
        <ToggleButton fx:id="tabAjustes" text="AJUSTES RÁPIDOS"
                      onAction="#onTabAjustes" selected="true"
                      style="-fx-background-color: #1e1e2e; -fx-text-fill: #89b4fa;
                             -fx-font-size: 11px; -fx-font-weight: bold;
                             -fx-padding: 10 16; -fx-background-radius: 0; -fx-cursor: hand;"/>
        <ToggleButton fx:id="tabGestion" text="GESTIÓN PANT."
                      onAction="#onTabGestion"
                      style="-fx-background-color: #181825; -fx-text-fill: #6c7086;
                             -fx-font-size: 11px; -fx-font-weight: bold;
                             -fx-padding: 10 16; -fx-background-radius: 0; -fx-cursor: hand;"/>
        <ToggleButton fx:id="tabRed" text="RED E IMS"
                      onAction="#onTabRed"
                      style="-fx-background-color: #181825; -fx-text-fill: #6c7086;
                             -fx-font-size: 11px; -fx-font-weight: bold;
                             -fx-padding: 10 16; -fx-background-radius: 0; -fx-cursor: hand;"/>
        <ToggleButton fx:id="tabWifi" text="ADB WIFI"
                      onAction="#onTabWifi"
                      style="-fx-background-color: #181825; -fx-text-fill: #6c7086;
                             -fx-font-size: 11px; -fx-font-weight: bold;
                             -fx-padding: 10 16; -fx-background-radius: 0; -fx-cursor: hand;"/>
    </HBox>

    <!-- CONTENIDO -->
    <StackPane VBox.vgrow="ALWAYS">

        <!-- PESTAÑA 1: Ajustes Rápidos -->
        <VBox fx:id="paneAjustes" visible="true" managed="true">
            <fx:include source="pane_ajustes_rapidos.fxml" fx:id="ajustesRapidos"/>
        </VBox>

        <!-- PESTAÑA 2: Gestión Pantalla -->
        <VBox fx:id="paneGestion" visible="false" managed="false">
            <fx:include source="pane_gestion_pantalla.fxml" fx:id="gestionPantalla"/>
        </VBox>

        <!-- PESTAÑA 3: Red e IMS -->
        <VBox fx:id="paneRed" visible="false" managed="false">
            <fx:include source="pane_red_ims.fxml" fx:id="redIms"/>
        </VBox>

        <!-- PESTAÑA 4: ADB WiFi -->
        <VBox fx:id="paneWifi" visible="false" managed="false">
            <fx:include source="pane_adb_wifi.fxml" fx:id="adbWifi"/>
        </VBox>

    </StackPane>

</VBox>
