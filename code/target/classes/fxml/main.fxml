<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.View.MainController"
            style="-fx-background-color: #1e1e2e;">

    <!-- Barra superior -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #181825; -fx-padding: 12 20 12 20;">
            <Label text="⚡ AEA Suite"
                   style="-fx-text-fill: #cdd6f4; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblEstadoAdb"
                   text="● ADB no iniciado"
                   style="-fx-text-fill: #f38ba8; -fx-font-size: 13px;"/>
            <Button fx:id="btnRefrescar"
                    text="Refrescar"
                    onAction="#onRefrescar"
                    style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e;
                           -fx-font-weight: bold; -fx-background-radius: 6;
                           -fx-padding: 6 14 6 14;
                           -fx-cursor:hand;"/>
        </HBox>
    </top>

    <!-- Contenido principal -->
    <center>
        <HBox style="-fx-background-color: #1e1e2e;">
            <!-- Panel izquierdo: lista de dispositivos (ancho fijo, nunca se encoge) -->
          <VBox fx:id="panelLista" spacing="12"
      minWidth="260" maxWidth="260" prefWidth="260"
      HBox.hgrow="NEVER"
      style="-fx-background-color: #181825; -fx-padding: 16;">

    <Label text="DISPOSITIVOS CONECTADOS"
           style="-fx-text-fill: #6c7086; -fx-font-size: 11px; -fx-font-weight: bold;"/>
    
    <ListView fx:id="listaDispositivos"
              VBox.vgrow="ALWAYS" 
              onMouseClicked="#onSeleccionarDispositivo"
              style="-fx-background-color: #1e1e2e; -fx-border-color: #313244;
                     -fx-border-radius: 8; -fx-background-radius: 8;"/>

    <VBox spacing="10" VBox.vgrow="NEVER">
        <Separator style="-fx-opacity: 0.1;"/>
        <Button fx:id="btnMasivo"
                text="📦 Instalación Masiva"
                onAction="#onMostrarMasivo"
                maxWidth="Infinity" 
                style="-fx-background-color: #cba6f7; -fx-text-fill: #1e1e2e; 
                       -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12;
                       -fx-cursor: hand;"/>
        <!-- Boton de APNs -->
        <Button text="Actualizar APNs"
                onAction="#onActualizarAPNs"
                maxWidth="Infinity"
                style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e; 
                       -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12;
                       -fx-cursor: hand;"/>
    </VBox>
</VBox>

            <!--
                Zona de contenido: ocupa todo el espacio restante (hgrow=ALWAYS).
                Dentro, un StackPane centra el panel y le aplica maxWidth.
            -->
            <StackPane HBox.hgrow="ALWAYS"
                       style="-fx-background-color: #1e1e2e;"
                       fx:id="rootPane">

                <!-- Panel central limitado a XXXpx y centrado -->
                <StackPane fx:id="panelCentral"
                           maxWidth="1400"
                           style="-fx-background-color: #1e1e2e; -fx-padding:0;">
                    <VBox alignment="CENTER" spacing="12">
                        <Label text="📱" style="-fx-font-size: 48px;"/>
                        <Label text="Conecta un dispositivo o selecciona uno de la lista"
                               style="-fx-text-fill: #6c7086; -fx-font-size: 14px;"/>
                    </VBox>
                </StackPane>

            </StackPane>

        </HBox>
    </center>

</BorderPane>