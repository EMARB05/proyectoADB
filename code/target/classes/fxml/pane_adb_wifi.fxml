<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="32" style="-fx-background-color: #1e1e2e; -fx-padding: 32;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.View.AdbWifiController">

    <!-- Título -->
    <Label text="Conexión ADB"
           style="-fx-text-fill: #cdd6f4; -fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- Separador -->
    <Separator style="-fx-background-color: #313244;"/>

    <!-- Tarjeta WiFi -->
    <VBox spacing="8" style="-fx-background-color: #313244;
                              -fx-background-radius: 12;
                              -fx-padding: 20;">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="📶" style="-fx-font-size: 22px;"/>
            <VBox spacing="2">
                <Label text="ADB por WiFi"
                       style="-fx-text-fill: #cdd6f4; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Label text="Conecta sin cable usando la red local"
                       style="-fx-text-fill: #6c7086; -fx-font-size: 12px;"/>
            </VBox>
        </HBox>
        <Button text="⚡  Conectar por WiFi"
                onAction="#conectarAdbWifi"
                maxWidth="Infinity"
                style="-fx-background-color: #00b894;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-font-size: 13px;
                       -fx-background-radius: 8;
                       -fx-padding: 10 0;
                       -fx-cursor: hand;"/>
    </VBox>

    <!-- Tarjeta USB -->
    <VBox spacing="8" style="-fx-background-color: #313244;
                              -fx-background-radius: 12;
                              -fx-padding: 20;">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="🔌" style="-fx-font-size: 22px;"/>
            <VBox spacing="2">
                <Label text="ADB por USB"
                       style="-fx-text-fill: #cdd6f4; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Label text="Vuelve al modo cable y desconecta WiFi"
                       style="-fx-text-fill: #6c7086; -fx-font-size: 12px;"/>
            </VBox>
        </HBox>
        <Button text="🔗  Conectar por USB"
                onAction="#conectarAdbUsb"
                maxWidth="Infinity"
                style="-fx-background-color: #0984e3;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-font-size: 13px;
                       -fx-background-radius: 8;
                       -fx-padding: 10 0;
                       -fx-cursor: hand;"/>
    </VBox>

    <!-- Estado actual -->
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="●" fx:id="lblPunto"
               style="-fx-text-fill: #a6e3a1; -fx-font-size: 14px;"/>
        <Label fx:id="lblEstado" text="Conexión: WiFi"
               style="-fx-text-fill: #6c7086; -fx-font-size: 12px;"/>
    </HBox>

</VBox>