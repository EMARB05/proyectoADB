<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="rootPane"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.View.ComparadorApnController"
           style="-fx-background-color: #1e1e2e;">

    <VBox spacing="0">
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #181825; -fx-padding: 12 20;">
            <Button text="← ATRÁS"
                    onAction="#onVolver"
                    style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4;
                           -fx-font-weight: bold; -fx-background-radius: 8;
                           -fx-padding: 8 16; -fx-cursor: hand;"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #11111b; -fx-padding: 12 20;">
            <Label text="Seleccionar XML :" style="-fx-text-fill: #cdd6f4; -fx-font-size: 13px;"/>
            <Button fx:id="btnXml" text="Seleccionar archivo" onAction="#onSeleccionarXml"
                    style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-background-radius: 6; -fx-padding: 6 16; -fx-cursor: hand;"/>
            
            <Label text="Seleccionar XLSX :" style="-fx-text-fill: #cdd6f4; -fx-font-size: 13px;"/>
            <Button fx:id="btnXlsx" text="Seleccionar archivo" onAction="#onSeleccionarXlsx"
                    style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-background-radius: 6; -fx-padding: 6 16; -fx-cursor: hand;"/>
        </HBox>

        <HBox alignment="CENTER"
              style="-fx-background-color: #11111b; -fx-padding: 12 20; -fx-border-color: #313244; -fx-border-width: 1 0 1 0;">
            <Label fx:id="lblOperadorActual" text=""
                   style="-fx-text-fill: #cdd6f4; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        </HBox>

        <HBox VBox.vgrow="ALWAYS" spacing="0">

            <VBox HBox.hgrow="ALWAYS" spacing="0"
                  style="-fx-background-color: #11111b; -fx-border-color: #313244; -fx-border-width: 0 1 0 0; -fx-text-fill: #cdd6f4;">
                <StackPane fx:id="contenedorXml" style="-fx-text-fill: #cdd6f4;" VBox.vgrow="ALWAYS" />
            </VBox>

<StackPane prefWidth="650" maxWidth="800" minWidth="400">
    <VBox spacing="0" style="-fx-background-color: #1e1e2e;">
        <ScrollPane fx:id="scrollExcel" VBox.vgrow="ALWAYS" fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <GridPane fx:id="gridExcel" style="-fx-background-color: #ffffff; -fx-padding: 8;"/>
        </ScrollPane>

                <HBox fx:id="panelBotones"
                      alignment="CENTER_RIGHT" spacing="12"
                      visible="false" managed="false"
                      style="-fx-background-color: #181825; -fx-padding: 12 20;">
                    <Button fx:id="btnAniadir" text="⊕ AÑADIR" onAction="#onAniadir"
                            style="-fx-background-color: #a6e3a1; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 24; -fx-cursor: hand;"/>
                    <Button fx:id="btnCancelar" text="✕ CANCELAR" onAction="#onCancelar"
                            style="-fx-background-color: #f38ba8; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 24; -fx-cursor: hand;"/>
                </HBox>
    </VBox>

    <VBox fx:id="overlayCarga" alignment="CENTER" spacing="15" visible="false" opacity="0"
          style="-fx-background-color: rgba(30, 30, 46, 0.85);">
        <ProgressIndicator prefWidth="50" prefHeight="50" />
        <Label fx:id="lblMensajeCarga" text="" style="-fx-text-fill: #cdd6f4; -fx-font-weight: bold;"/>
    </VBox>
</StackPane>
        </HBox>
    </VBox>
</StackPane>