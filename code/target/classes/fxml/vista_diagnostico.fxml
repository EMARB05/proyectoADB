<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.FlowPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.control.ScrollPane?>

<HBox spacing="20" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.View.DiagnosticoController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Columna izquierda: ficha técnica -->
    <VBox fx:id="contenedorFicha" HBox.hgrow="ALWAYS">
        <fx:include fx:id="fichaTecnica" source="ficha_tecnica.fxml" />
    </VBox>

    <!-- Columna derecha: panel de pruebas, con margen izquierdo extra -->
    <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-padding: 0 0 0 24;">
        <Label text="PANEL DE CONTROL DE PRUEBAS"
               style="-fx-text-fill: #89b4fa; -fx-font-weight: bold;"
               styleClass="card-container"/>

    <VBox spacing="8"
        prefWidth="530" maxWidth="530" 
        style="-fx-background-color: #313244; -fx-padding: 10; -fx-background-radius: 8;">
        
        <Label text="Conectividad &amp; Red"
            style="-fx-text-fill: #cdd6f4; -fx-font-size: 11px;"/>
        
        <HBox alignment="CENTER" spacing="10" maxWidth="Infinity">
            
            <Button fx:id="btnFlechaIzquierda" onAction="#scrollIzquierda" styleClass="btn-flecha-slider">
                <graphic>
                    <FontIcon iconLiteral="fas-chevron-left" iconSize="16" iconColor="#cdd6f4"/>
                </graphic>
            </Button>

            <ScrollPane fx:id="scrollCategorias" 
                        vbarPolicy="NEVER" 
                        hbarPolicy="NEVER" 
                        fitToHeight="true" 
                        HBox.hgrow="ALWAYS"
                        style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
                
                <HBox spacing="25" alignment="CENTER_LEFT">
                    <Button onAction="#addWifiOn" styleClass="btn-action,btn-modern,btn-network">
                        <graphic>
                            <VBox alignment="CENTER" spacing="5">
                                <FontIcon iconLiteral="fas-wifi" iconSize="24" iconColor="#a6e3a1"/>
                                <Label text="ON WIFI" style="-fx-font-size: 9px;"/>
                            </VBox>
                        </graphic>
                    </Button>
                    <Button onAction="#addWifiOff" styleClass="btn-action,btn-modern,btn-network">
                        <graphic>
                            <VBox alignment="CENTER" spacing="8">
                                <ImageView fitHeight="30" fitWidth="30" preserveRatio="true">
                                    <image>
                                        <Image url="@../img/wifi-apagado.png"/>
                                    </image>
                                </ImageView>
                                <Label text="OFF WIFI" styleClass="btn-label"/>
                            </VBox>
                        </graphic>
                    </Button>
                    <Button onAction="#addPingStep" styleClass="btn-action,btn-modern,btn-network">
                        <graphic>
                            <VBox alignment="CENTER" spacing="5">
                                <FontIcon iconLiteral="fas-network-wired" iconSize="24" iconColor="#89b4fa"/>
                                <Label text="PING" style="-fx-font-size: 9px;"/>
                            </VBox>
                        </graphic>
                    </Button>
                    <Button onAction="#addClockTest" styleClass="btn-hw,btn-modern">
                        <graphic>
                            <VBox alignment="CENTER" spacing="5">
                                <FontIcon iconLiteral="far-clock" iconSize="24" iconColor="#fc921a"/>
                                <Label text="CLOCK" style="-fx-font-size: 9px;"/>
                            </VBox>
                        </graphic>
                    </Button>
                    <Button onAction="#exportarApnXml" styleClass="btn-hw,btn-modern">
                        <graphic>
                            <VBox alignment="CENTER" spacing="5">
                                <FontIcon iconLiteral="fas-file-export" iconSize="24" iconColor="#94e2d5"/>
                                <Label text="EXPORT APNs" style="-fx-font-size: 9px;"/>
                            </VBox>
                        </graphic>
                    </Button>
                    <Button onAction="#addInfoTest" styleClass="btn-hw,btn-modern">
                        <graphic>
                            <VBox alignment="CENTER" spacing="5">
                                <FontIcon iconLiteral="fas-info-circle" iconSize="24" iconColor="#517fff"/>
                                <Label text="Info" style="-fx-font-size: 9px;"/>
                            </VBox>
                        </graphic>
                    </Button>

                </HBox>
            </ScrollPane>

            <Button fx:id="btnFlechaDerecha" onAction="#scrollDerecha" styleClass="btn-flecha-slider">
                <graphic>
                    <FontIcon iconLiteral="fas-chevron-right" iconSize="16" iconColor="#cdd6f4"/>
                </graphic>
            </Button>
            
        </HBox>
    </VBox>

<VBox spacing="8" prefWidth="530" maxWidth="530"
              style="-fx-background-color: #313244; -fx-padding: 10; -fx-background-radius: 8;"
              styleClass="card-container">
            
            <Label text="Pruebas de Hardware"
                   style="-fx-text-fill: #cdd6f4; -fx-font-size: 11px;"/>

            <HBox alignment="CENTER" spacing="10" maxWidth="Infinity">
                <Button fx:id="btnFlechaIzquierdaHw" onAction="#scrollIzquierdaHw" styleClass="btn-flecha-slider">
                    <graphic>
                        <FontIcon iconLiteral="fas-chevron-left" iconSize="16" iconColor="#cdd6f4"/>
                    </graphic>
                </Button>

                <ScrollPane fx:id="scrollHardware" vbarPolicy="NEVER" hbarPolicy="NEVER" 
                            fitToHeight="true" HBox.hgrow="ALWAYS"
                            style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
                    
                    <HBox spacing="25" alignment="CENTER_LEFT">
                        <Button onAction="#addSoundTest" styleClass="btn-hw,btn-modern">
                            <graphic>
                                <VBox alignment="CENTER" spacing="5">
                                    <FontIcon iconLiteral="fas-volume-up" iconSize="24" iconColor="#cba6f7"/>
                                    <Label text="SOUND" style="-fx-font-size: 9px;"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button onAction="#addVibrateStep" styleClass="btn-hw,btn-modern">
                            <graphic>
                                <VBox alignment="CENTER" spacing="5">
                                    <FontIcon iconLiteral="fas-mobile-alt" iconSize="24" iconColor="#fab387"/>
                                    <Label text="VIBRATE" style="-fx-font-size: 9px;"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button onAction="#addTouchScreenTest" styleClass="btn-hw,btn-modern">
                            <graphic>
                                <VBox alignment="CENTER" spacing="5">
                                    <FontIcon iconLiteral="fas-fingerprint" iconSize="24" iconColor="#dcfbff"/>
                                    <Label text="TOUCHSCREEN" style="-fx-font-size: 9px;"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button onAction="#addDisplayTest" styleClass="btn-hw,btn-modern">
                            <graphic>
                                <VBox alignment="CENTER" spacing="5">
                                    <FontIcon iconLiteral="fas-expand" iconSize="24" iconColor="#36fc61"/>
                                    <Label text="Display" style="-fx-font-size: 9px;"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button onAction="#addCallTest" styleClass="btn-hw,btn-modern">
                    <graphic>
                        <VBox alignment="CENTER" spacing="5">
                            <FontIcon iconLiteral="fas-phone" iconSize="24" iconColor="#f9e2af"/>
                            <Label text="CALL" style="-fx-font-size: 9px;"/>
                        </VBox>
                    </graphic>
                </Button>
                <Button onAction="#calibrarDispositivo" styleClass="btn-hw,btn-modern">
    <graphic>
        <VBox alignment="CENTER" spacing="5">
            <FontIcon iconLiteral="fas-sliders-h" iconSize="24" iconColor="#89dceb"/>
            <Label text="CALIBRAR" style="-fx-font-size: 9px;"/>
        </VBox>
    </graphic>
</Button>
                                <Button onAction="#calibrarTecladoManual" styleClass="btn-hw,btn-modern">
                                    <graphic>
                                        <VBox alignment="CENTER" spacing="5">
                                            <FontIcon iconLiteral="fas-keyboard" iconSize="24" iconColor="#89dceb"/>
                                            <Label text="CAL TECLADO" style="-fx-font-size: 9px;"/>
                                        </VBox>
                                    </graphic>
                                </Button>
                    </HBox>
                </ScrollPane>

                <Button fx:id="btnFlechaDerechaHw" onAction="#scrollDerechaHw" styleClass="btn-flecha-slider">
                    <graphic>
                        <FontIcon iconLiteral="fas-chevron-right" iconSize="16" iconColor="#cdd6f4"/>
                    </graphic>
                </Button>
                
            </HBox>
        </VBox>

        <ListView fx:id="listaPasos" VBox.vgrow="ALWAYS" style="-fx-text-fill: #6a0dad;"/>

        <HBox spacing="10">
            <Button fx:id="btnEjecutar" text="EJECUTAR" onAction="#ejecutarScript"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS"
                    styleClass="btnEjecutar" style="-fx-padding: 10"/>
            <Button fx:id="btnInforme" text="INFORME" onAction="#generarInformePDF"
                    disable="true" styleClass="#btnInforme" style="-fx-padding: 10"/>
            <Button text="Limpiar" onAction="#limpiarPasos" styleClass="btn-footer">
                <graphic>
                    <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                        <image><Image url="@../img/borrar.png"/></image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
    </VBox>
</HBox>