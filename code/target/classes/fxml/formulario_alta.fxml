<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.View.FormularioAltaController">

    <VBox spacing="20" style="-fx-padding: 24;">

        <VBox spacing="4">
            <Label text="Nuevo dispositivo detectado"
                   style="-fx-text-fill: #cdd6f4; -fx-font-size: 20px;
                          -fx-font-weight: bold;"/>
            <Label text="Completa la ficha técnica para registrarlo en la base de datos"
                   style="-fx-text-fill: #6c7086; -fx-font-size: 13px;"/>
        </VBox>

        <VBox spacing="6"
              style="-fx-background-color: #181825; -fx-background-radius: 10;
                     -fx-padding: 16;">
            <Label text="SERIAL NUMBER"
                   style="-fx-text-fill: #6c7086; -fx-font-size: 11px;
                          -fx-font-weight: bold;"/>
            <Label fx:id="lblSerial"
                   text="—"
                   style="-fx-text-fill: #a6e3a1; -fx-font-size: 15px;
                          -fx-font-family: monospace;"/>
        </VBox>

        <GridPane hgap="16" vgap="16">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <children>
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="6">
                    <Label text="Marca"
                           style="-fx-text-fill: #cdd6f4; -fx-font-size: 13px;"/>
                    <TextField fx:id="txtMarca"
                               promptText="Ej: Samsung"
                               style="-fx-background-color: #181825; -fx-text-fill: #cdd6f4;
                                      -fx-border-color: #313244; -fx-border-radius: 6;
                                      -fx-background-radius: 6; -fx-padding: 8;"/>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="6">
                    <Label text="Modelo"
                           style="-fx-text-fill: #cdd6f4; -fx-font-size: 13px;"/>
                    <TextField fx:id="txtModelo"
                               promptText="Ej: Galaxy S22"
                               style="-fx-background-color: #181825; -fx-text-fill: #cdd6f4;
                                      -fx-border-color: #313244; -fx-border-radius: 6;
                                      -fx-background-radius: 6; -fx-padding: 8;"/>
                </VBox>

                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" spacing="6">
                    <Label text="Procesador (SoC)"
                           style="-fx-text-fill: #cdd6f4; -fx-font-size: 13px;"/>
                    <TextField fx:id="txtSoc"
                               promptText="Ej: Snapdragon 8 Gen 2"
                               style="-fx-background-color: #181825; -fx-text-fill: #cdd6f4;
                                      -fx-border-color: #313244; -fx-border-radius: 6;
                                      -fx-background-radius: 6; -fx-padding: 8;"/>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="6">
                    <Label text="RAM (GB)"
                           style="-fx-text-fill: #cdd6f4; -fx-font-size: 13px;"/>
                    <TextField fx:id="txtRam"
                               promptText="Ej: 8"
                               style="-fx-background-color: #181825; -fx-text-fill: #cdd6f4;
                                      -fx-border-color: #313244; -fx-border-radius: 6;
                                      -fx-background-radius: 6; -fx-padding: 8;"/>
                </VBox>

                <VBox GridPane.columnIndex="0" GridPane.rowIndex="2" spacing="6">
                    <Label text="Almacenamiento (GB)"
                           style="-fx-text-fill: #cdd6f4; -fx-font-size: 13px;"/>
                    <TextField fx:id="txtAlmacenamiento"
                               promptText="Ej: 128"
                               style="-fx-background-color: #181825; -fx-text-fill: #cdd6f4;
                                      -fx-border-color: #313244; -fx-border-radius: 6;
                                      -fx-background-radius: 6; -fx-padding: 8;"/>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="2" spacing="6">
                    <Label text="Versión Android"
                           style="-fx-text-fill: #cdd6f4; -fx-font-size: 13px;"/>
                    <TextField fx:id="txtAndroid"
                               promptText="Ej: Android 13"
                               style="-fx-background-color: #181825; -fx-text-fill: #cdd6f4;
                                      -fx-border-color: #313244; -fx-border-radius: 6;
                                      -fx-background-radius: 6; -fx-padding: 8;"/>
                </VBox>

                <VBox GridPane.columnIndex="0" GridPane.rowIndex="3" spacing="6">
                    <Label text="Pantalla (pulgadas)"
                           style="-fx-text-fill: #cdd6f4; -fx-font-size: 13px;"/>
                    <TextField fx:id="txtPantalla"
                               promptText="Ej: 6.1"
                               style="-fx-background-color: #181825; -fx-text-fill: #cdd6f4;
                                      -fx-border-color: #313244; -fx-border-radius: 6;
                                      -fx-background-radius: 6; -fx-padding: 8;"/>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="3" spacing="6">
                    <Label text="Cámara (MP)"
                           style="-fx-text-fill: #cdd6f4; -fx-font-size: 13px;"/>
                    <TextField fx:id="txtCamara"
                               promptText="Ej: 50"
                               style="-fx-background-color: #181825; -fx-text-fill: #cdd6f4;
                                      -fx-border-color: #313244; -fx-border-radius: 6;
                                      -fx-background-radius: 6; -fx-padding: 8;"/>
                </VBox>
            </children>
        </GridPane>

        <VBox spacing="6">
            <Label text="Foto del dispositivo"
                   style="-fx-text-fill: #cdd6f4; -fx-font-size: 13px;"/>
            <HBox spacing="10">
                <children>
                    <TextField fx:id="txtRutaFoto"
                               editable="false"
                               promptText="No se ha seleccionado ninguna imagen..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #181825; -fx-text-fill: #cdd6f4;
                                      -fx-border-color: #313244; -fx-border-radius: 6;
                                      -fx-background-radius: 6; -fx-padding: 8;"/>
                    <Button onAction="#onSeleccionarFoto"
                            text="📁"
                            style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e;
                                   -fx-font-weight: bold; -fx-background-radius: 6;
                                   -fx-padding: 8 15; -fx-cursor: hand;"/>
                </children>
            </HBox>
        </VBox>

        <VBox spacing="6">
            <Label text="Notas"
                   style=" -fx-font-size: 13px;"/>
            <TextArea fx:id="txtNotas"
                      promptText="Observaciones sobre el dispositivo..."
                      prefRowCount="3"
                      style="-fx-background-color: #181825; 
                             -fx-border-color: #313244; -fx-border-radius: 6;
                             -fx-background-radius: 6; -fx-padding: 8;"/>
        </VBox>

        <HBox alignment="CENTER_RIGHT">
            <Button fx:id="btnGuardar"
                    text="Registrar dispositivo"
                    onAction="#onGuardar"
                    style="-fx-background-color: #a6e3a1; -fx-text-fill: #1e1e2e;
                           -fx-font-weight: bold; -fx-font-size: 14px;
                           -fx-background-radius: 8; -fx-padding: 10 24 10 24;
                           -fx-cursor: hand;"/>
        </HBox>

    </VBox>
</ScrollPane>