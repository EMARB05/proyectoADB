<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox spacing="25.0" stylesheets="@/css/dispositivos.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.Controller.DispositivosViewController">
   <children>
      
      <VBox alignment="TOP_CENTER" prefWidth="300.0" spacing="15.0" styleClass="card-container">
         <children>
            <Label text="FOTO DEL EQUIPO" styleClass="section-title" />
            <ImageView fx:id="imgDispositivo" fitHeight="350.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" />
            <Button text="🔄 Cambiar Foto" styleClass="action-button-secondary" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>

      <VBox spacing="20.0" HBox.hgrow="ALWAYS">
         <children>
            <VBox spacing="10.0" styleClass="card-container">
               <children>
                  <Label fx:id="lblModelo" text="MODELO DEL EQUIPO" styleClass="model-title" />
                  <Separator opacity="0.1"/>
                  
                 <GridPane vgap="15.0">
                   <columnConstraints>
                   <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                   <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                  </columnConstraints>
  <rowConstraints>
    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" /> </rowConstraints>
   <children>
      <Label text="MARCA:" styleClass="label-prop" />
      <Label fx:id="lblMarca" text="---" styleClass="label-value" GridPane.columnIndex="1" />
      
      <Label text="PROCESADOR:" styleClass="label-prop" GridPane.rowIndex="1" />
      <Label fx:id="lblSoc" text="---" styleClass="label-value" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      
      <Label text="MEMORIA RAM:" styleClass="label-prop" GridPane.rowIndex="2" />
      <Label fx:id="lblRam" text="---" styleClass="label-value" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      
      <Label text="S. OPERATIVO:" styleClass="label-prop" GridPane.rowIndex="3" />
      <Label fx:id="lblSo" text="---" styleClass="label-value" GridPane.columnIndex="1" GridPane.rowIndex="3" />

      <Label text="BANDAS:" styleClass="label-prop" GridPane.rowIndex="4" />
      <Label fx:id="lblBandas" text="---" styleClass="label-value" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />
   </children>
</GridPane>
<Button fx:id="btnRegistrar" text="📝 Registrar en Vimbiocorp" 
        onAction="#handleRegistrarEquipo" 
        styleClass="action-button-primary" 
        visible="false" />
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </children>
</HBox>