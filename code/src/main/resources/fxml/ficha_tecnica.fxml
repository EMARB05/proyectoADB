<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="rootPane"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.View.FichaTecnicaController">

    <ScrollPane fitToWidth="true"
                style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="20" style="-fx-padding: 24;">

        <!-- Cabecera: foto + nombre + serial -->
        <HBox spacing="24" alignment="CENTER_LEFT"
              style="-fx-background-color: #181825; -fx-background-radius: 12;
                     -fx-padding: 20;">

              <StackPane minWidth="180" minHeight="180" style="-fx-background-color: #313244;"> 
              <ImageView fx:id="imgDispositivo"
                            fitWidth="180" 
                            fitHeight="180"
                            preserveRatio="true"/>
              </StackPane>

              <VBox spacing="8" HBox.hgrow="ALWAYS" minWidth="0"> 
       <Label fx:id="lblNombreModelo"
              text="—"
              maxWidth="Infinity"
              minWidth="200"
              style="-fx-text-fill: #cdd6f4; -fx-font-size: 24px; -fx-font-weight: bold;"/>
       
       <Label fx:id="lblMarca"
              text="—"
              maxWidth="Infinity"
              minWidth="220"
              style="-fx-text-fill: #89b4fa; -fx-font-size: 14px;"/>

       <Label fx:id="lblAndroidId"
              text="Android ID: —"
              maxWidth="Infinity" 
              minWidth="200"
              styleClass="label-datos"
              style="-fx-text-overrun: CLIP;"/>
       <Label fx:id="lblSerial"
              text="Serial: —"
              maxWidth="Infinity"
              styleClass="label-datos"/>

       <Label fx:id="lblFechaRegistro"
              text="Registrado: —"
              minWidth="200"
              maxWidth="Infinity"
              styleClass="label-datos"/>
       </VBox>

             <!-- Botón scrcpy alineado a la derecha -->
              <VBox alignment="CENTER_RIGHT" spacing="12" prefWidth="240.0">
                <Button fx:id="btnLaboratorio"
                        onAction="#abrirLaboratorio"
                        minWidth="220"
                        style="-fx-background-color: #cba6f7; -fx-text-fill: #1e1e2e;
                               -fx-font-weight: bold; -fx-font-size: 13px;
                               -fx-background-radius: 8; -fx-padding: 12;
                               -fx-cursor: hand;">
                             <graphic>
                        <HBox alignment="CENTER" spacing="8">
                            <ImageView fitHeight="15" fitWidth="15" preserveRatio="true" styleClass="img-btnficha">
                                <image>
                                    <Image url="@../img/energia.png"/>
                                </image>
                            </ImageView>
                            <Label text="Laboratorio Energía" styleClass="btn-label"/>
                        </HBox>
                    </graphic>

                 </Button>

                <Button fx:id="btnGestionar"
                        onAction="#onAbrirAjustes"
                        minWidth="220"
                        style="-fx-background-color: #cba6f7; -fx-text-fill: #1e1e2e;
                               -fx-font-weight: bold; -fx-font-size: 13px;
                               -fx-background-radius: 8; -fx-padding: 10;
                               -fx-cursor: hand;">
                          <graphic>
                               <HBox alignment="CENTER" spacing="8">
                            <ImageView fitHeight="15" fitWidth="15" preserveRatio="true" styleClass="img-btnficha">
                                <image>
                                    <Image url="@../img/ajustes.png"/>
                                </image>
                            </ImageView>
                            <Label text="Gestionar Dispositivo" styleClass="btn-label"/>
                        </HBox>
                         </graphic>
                 </Button>
            </VBox>
                            

        </HBox>

        <!-- Tarjetas de specs -->
        <GridPane hgap="12" vgap="12">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <!-- SoC -->
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0"
                  spacing="4"
                  style="-fx-background-color: #181825; -fx-background-radius: 10;
                         -fx-padding: 16;">
                <Label text="PROCESADOR"
                       style="-fx-text-fill: #6c7086; -fx-font-size: 11px;
                              -fx-font-weight: bold;"/>
                <Label fx:id="lblSoc"
                       text="—"
                       style="-fx-text-fill: #cdd6f4; -fx-font-size: 15px;"/>
                <Label fx:id="lblSocFabricante"
                       text="—"
                       style="-fx-text-fill: #89b4fa; -fx-font-size: 12px;"/>
            </VBox>

            <!-- RAM -->
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0"
                  spacing="4"
                  style="-fx-background-color: #181825; -fx-background-radius: 10;
                         -fx-padding: 16;">
                <Label text="MEMORIA RAM"
                       style="-fx-text-fill: #6c7086; -fx-font-size: 11px;
                              -fx-font-weight: bold;"/>
                <Label fx:id="lblRam"
                       text="—"
                       style="-fx-text-fill: #cdd6f4; -fx-font-size: 15px;"/>
            </VBox>

            <!-- Almacenamiento -->
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="1"
                  spacing="4"
                  style="-fx-background-color: #181825; -fx-background-radius: 10;
                         -fx-padding: 16;">
                <Label text="ALMACENAMIENTO"
                       style="-fx-text-fill: #6c7086; -fx-font-size: 11px;
                              -fx-font-weight: bold;"/>
                <Label fx:id="lblAlmacenamiento"
                       text="—"
                       style="-fx-text-fill: #cdd6f4; -fx-font-size: 15px;"/>
            </VBox>

            <!-- Android -->
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="1"
                  spacing="4"
                  style="-fx-background-color: #181825; -fx-background-radius: 10;
                         -fx-padding: 16;">
                <Label text="VERSIÓN ANDROID"
                       style="-fx-text-fill: #6c7086; -fx-font-size: 11px;
                              -fx-font-weight: bold;"/>
                <Label fx:id="lblAndroid"
                       text="—"
                       style="-fx-text-fill: #cdd6f4; -fx-font-size: 15px;"/>
            </VBox>

            <!-- Pantalla -->
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="2"
                  spacing="4"
                  style="-fx-background-color: #181825; -fx-background-radius: 10;
                         -fx-padding: 16;">
                <Label text="PANTALLA"
                       style="-fx-text-fill: #6c7086; -fx-font-size: 11px;
                              -fx-font-weight: bold;"/>
                <Label fx:id="lblPantalla"
                       text="—"
                       style="-fx-text-fill: #cdd6f4; -fx-font-size: 15px;"/>
            </VBox>

            <!-- Cámara -->
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="2"
                  spacing="4"
                  style="-fx-background-color: #181825; -fx-background-radius: 10;
                         -fx-padding: 16;">
                <Label text="CÁMARA"
                       style="-fx-text-fill: #6c7086; -fx-font-size: 11px;
                              -fx-font-weight: bold;"/>
                <Label fx:id="lblCamara"
                       text="—"
                       style="-fx-text-fill: #cdd6f4; -fx-font-size: 15px;"/>
            </VBox>

        </GridPane>

        <!-- Bandas soportadas -->
        <VBox spacing="8"
              style="-fx-background-color: #181825; -fx-background-radius: 10;
                     -fx-padding: 16;">
            <Label text="BANDAS SOPORTADAS"
                   style="-fx-text-fill: #6c7086; -fx-font-size: 11px;
                          -fx-font-weight: bold;"/>
            <FlowPane fx:id="panelBandas" hgap="8" vgap="8"/>
        </VBox>

        <!-- Notas -->
        <VBox spacing="8"
              style="-fx-background-color: #181825; -fx-background-radius: 10;
                     -fx-padding: 16;">
            <Label text="NOTAS"
                   style="-fx-text-fill: #6c7086; -fx-font-size: 11px;
                          -fx-font-weight: bold;"/>
            <Label fx:id="lblNotas"
                   text="—"
                   wrapText="true"
                   style="-fx-text-fill: #cdd6f4; -fx-font-size: 13px;"/>
        </VBox>

       <!-- Botón logs -->
              <HBox alignment="CENTER_RIGHT" spacing="12">
                     <Button text="📋 Guardar Logs"
                            onAction="#onAbrirLogcat"
                            style="-fx-background-color: #000000; -fx-text-fill: #4cdb77;
                                   -fx-font-weight: bold; -fx-background-radius: 6;
                                   -fx-padding: 8 16 8 16;
                                   -fx-cursor: hand;
                                   -fx-border-width: 1; -fx-border-style: solid; -fx-border-color: #4cdb77; -fx-border-radius: 6;"/>
              </HBox>
    </VBox>
    </ScrollPane>

</StackPane>