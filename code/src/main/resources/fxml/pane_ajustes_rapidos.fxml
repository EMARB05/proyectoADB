<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" style="-fx-background-color: #1e1e2e; -fx-padding: 24;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.View.AjustesRapidosController">

    <!-- Toggles -->
    <GridPane hgap="15" vgap="15">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>
        <children>
            <ToggleButton fx:id="btnModoAvion" text="✈ Modo Avión"
                          onAction="#toggleAirplane" maxWidth="Infinity"
                          GridPane.columnIndex="0" GridPane.rowIndex="0"
                          style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4;
                                 -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <ToggleButton fx:id="btnBluetooth" text="🀆 Bluetooth"
                          onAction="#toggleBluetooth" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="0"
                          style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4;
                                 -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <ToggleButton fx:id="btnGPS" text="📍 Ubicación (GPS)"
                          onAction="#toggleGPS" maxWidth="Infinity"
                          GridPane.columnIndex="0" GridPane.rowIndex="1"
                          style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4;
                                 -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </children>
    </GridPane>

    <!-- Sliders -->
    <VBox spacing="15" style="-fx-background-color: #181825; -fx-padding: 15;
                               -fx-background-radius: 10;">
        <VBox spacing="8">
            <HBox spacing="10">
                <Label text="🔅 Brillo Pantalla" style="-fx-text-fill: #cdd6f4;"/>
                <Label fx:id="lblBrilloVal" text="128" style="-fx-text-fill: #6c7086;"/>
            </HBox>
            <Slider fx:id="sliderBrillo" min="0" max="255" value="128"/>
        </VBox>
        <VBox spacing="8">
            <HBox spacing="10">
                <Label text="🔊 Volumen Multimedia" style="-fx-text-fill: #cdd6f4;"/>
                <Label fx:id="lblVolVal" text="7" style="-fx-text-fill: #6c7086;"/>
            </HBox>
            <Slider fx:id="sliderVolumen" min="0" max="15" value="7"/>
        </VBox>
    </VBox>

</VBox>
