<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="rootPane"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.View.ComparadorExcelController"
           style="-fx-background-color: #1e1e2e;">

    <VBox spacing="20" style="-fx-padding: 24;">
        
        <!-- Encabezado con título y estado -->
        <HBox alignment="CENTER_LEFT" spacing="15">
           
            <VBox>
                <Label text="Comparador XML vs Excel" style="-fx-text-fill: #cdd6f4; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Sincronización de base de datos técnica" style="-fx-text-fill: #6c7086; -fx-font-size: 12px;"/>
            </VBox>
        </HBox>

<HBox spacing="20" alignment="CENTER_LEFT">
    <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="15" 
          style="-fx-background-color: #181825; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #45475a; -fx-border-radius: 12;">      
        <Label text="BASE DE DATOS XML" 
               style="-fx-text-fill: #89b4fa; -fx-font-weight: bold; -fx-font-size: 11px;"/>
        <Button fx:id="btnXml" onAction="#onSeleccionarXml" text="Seleccionar XML" 
                style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-cursor: hand;"/>
    </HBox>

    <HBox prefWidth="650" maxWidth="800" minWidth="400" alignment="CENTER_LEFT" spacing="15" 
          style="-fx-background-color: #181825; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #45475a; -fx-border-radius: 12;">
        <Label text="REPORTE EXCEL" 
               style="-fx-text-fill: #f5c2e7; -fx-font-weight: bold; -fx-font-size: 11px;"/>
        <Button fx:id="btnXlsx" onAction="#onSeleccionarXlsx" text="Seleccionar XLSX" 
                style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-cursor: hand;"/>
    </HBox>
</HBox>

        <!-- Área Central de Comparación -->
        <HBox VBox.vgrow="ALWAYS" spacing="20">
            
            <!-- Panel Izquierdo: Vista XML -->
            <VBox HBox.hgrow="ALWAYS" spacing="10" style="-fx-background-color: #181825; -fx-background-radius: 12; -fx-padding: 10; -fx-border-color: #45475a; -fx-border-radius: 12;">
                <Label text="ESTRUCTURA XML ACTUAL" style="-fx-text-fill: #cdd6f4; -fx-font-weight: bold;"/>
                <StackPane fx:id="contenedorXml" VBox.vgrow="ALWAYS" style="-fx-background-color: #1e1e2e; -fx-background-radius: 8;"/>
            </VBox>

            <!-- Panel Derecho: Vista Excel y Botones -->
            <StackPane prefWidth="650" maxWidth="800" minWidth="400">
                <VBox spacing="10" style="-fx-background-color: #181825; -fx-background-radius: 12; -fx-padding: 10; -fx-border-color: #45475a; -fx-border-radius: 12;">
                    
<HBox alignment="CENTER_LEFT" spacing="15">
    <Label text="VISTA PREVIA EXCEL" 
           style="-fx-text-fill: #cdd6f4; -fx-font-weight: bold;"/>
    
    <Label fx:id="lblOperadorActual" text="ESPERANDO ARCHIVOS" 
           style="-fx-background-color: #fab387; -fx-text-fill: #1e1e2e; -fx-padding: 5 12; -fx-background-radius: 15; -fx-font-weight: bold;"/>
</HBox>

                    <ScrollPane fx:id="scrollExcel" VBox.vgrow="ALWAYS" fitToWidth="true"
                               style="-fx-background-color: transparent; -fx-background: #ffffff; -fx-background-radius: 8;">
                        <GridPane fx:id="gridExcel" style="-fx-background-color: #ffffff; -fx-padding: 8;"/>
                    </ScrollPane>

                    <!-- Panel de Acciones -->
<HBox fx:id="panelBotones" alignment="CENTER_RIGHT" 
      visible="false" managed="false"
      style="-fx-padding: 10 0 0 0;">
    
    <HBox alignment="CENTER_LEFT">
        <Button fx:id="btnExportar" text="Exportar" onAction="#finalizarProceso"
                style="-fx-background-color: transparent; -fx-text-fill: #3e89fa; -fx-border-color: #3e89fa; -fx-border-radius: 6; -fx-cursor: hand; -fx-padding: 8 20;"/>
    </HBox>

    <Region HBox.hgrow="ALWAYS" />

    <HBox alignment="CENTER_RIGHT" spacing="12">
        <children> <Button fx:id="btnCancelar" text="✕ CANCELAR" onAction="#onCancelar"
                    style="-fx-background-color: transparent; -fx-text-fill: #f38ba8; -fx-border-color: #f38ba8; -fx-border-radius: 6; -fx-cursor: hand; -fx-padding: 8 20;"/>
            <Button fx:id="btnAniadir" text="⊕ AÑADIR AL XML" onAction="#onAniadir"
                    style="-fx-background-color: #a6e3a1; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 24; -fx-cursor: hand;"/>
        </children>
    </HBox>
</HBox>
                </VBox>

                <!-- Overlay de Carga -->
                <VBox fx:id="overlayCarga" alignment="CENTER" spacing="15" visible="false" opacity="0"
                      style="-fx-background-color: rgba(30, 30, 46, 0.9); -fx-background-radius: 12;" mouseTransparent="true">
                    <ProgressIndicator prefWidth="50" prefHeight="50" />
                    <Label fx:id="lblMensajeCarga" text="Procesando..." style="-fx-text-fill: #cdd6f4; -fx-font-weight: bold;"/>
                </VBox>
            </StackPane>
        </HBox>

    </VBox>
</StackPane>