<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" style="-fx-background-color: #1e1e2e; -fx-padding: 24;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.View.ComparadorXmlController">

    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox spacing="2">
            <Label text="Comparador de APNs"
                   style="-fx-text-fill: #cdd6f4; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="Mismo modelo y marca: Verificación de integridad"
                   style="-fx-text-fill: #6c7086; -fx-font-size: 12px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblEstado" text="LISTO"
               style="-fx-background-color: #a6e3a1; -fx-text-fill: #1e1e2e;
                      -fx-padding: 5 12; -fx-background-radius: 15; -fx-font-weight: bold;"/>
    </HBox>

    <HBox spacing="20" alignment="CENTER">

        <HBox HBox.hgrow="ALWAYS" spacing="15" alignment="CENTER_LEFT"
              style="-fx-background-color: #181825; -fx-padding: 15;
                     -fx-background-radius: 12; -fx-border-color: #45475a;
                     -fx-border-radius: 12;">
            <Label text="ARCHIVO ORIGINAL" minWidth="110"
                   style="-fx-text-fill: #89b4fa; -fx-font-weight: bold; -fx-font-size: 11px;"/>
            
            <Button fx:id="btnCargarOriginal"
                    text="Seleccionar XML"
                    onAction="#onCargarOriginal"
                    style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4;
                           -fx-background-radius: 6; -fx-padding: 6 16; -fx-cursor: hand;"/>
            
            
        </HBox>


        <HBox HBox.hgrow="ALWAYS" spacing="15" alignment="CENTER_LEFT"
              style="-fx-background-color: #181825; -fx-padding: 15;
                     -fx-background-radius: 12; -fx-border-color: #45475a;
                     -fx-border-radius: 12;">
            <Label text="ARCHIVO A COMPARAR" minWidth="110"
                   style="-fx-text-fill: #f5c2e7; -fx-font-weight: bold; -fx-font-size: 11px;"/>
            
            <Button fx:id="btnCargarCopia"
                    text="Seleccionar XML"
                    onAction="#onCargarCopia"
                    style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4;
                           -fx-background-radius: 6; -fx-padding: 6 16; -fx-cursor: hand;"/>
            
           
        </HBox>

    </HBox>

    <VBox VBox.vgrow="ALWAYS" spacing="10"
          style="-fx-background-color: #181825; -fx-background-radius: 12; -fx-padding: 2;">
        <TableView fx:id="tblDiferencias" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: transparent;">
            <columns>
                <TableColumn fx:id="colOperadora" text="Operadora (MCC-MNC)" prefWidth="500"/>
                <TableColumn fx:id="colNombre" text="Nombre"/>
                <TableColumn fx:id="colAtributo" text="Atributo" prefWidth="120"/>
                <TableColumn fx:id="colValorOriginal" text="Original" prefWidth="180"/>
                <TableColumn fx:id="colValorCopia" text="Archivo 2" prefWidth="180"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Limpiar" onAction="#onLimpiar"
                style="-fx-background-color: transparent; -fx-text-fill: #f38ba8;
                       -fx-border-color: #f38ba8; -fx-border-radius: 6;
                       -fx-padding: 10 20; -fx-cursor: hand;">
            <graphic>
                <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                    <image><Image url="@../img/borrar.png"/></image>
                </ImageView>
            </graphic>
        </Button>
        <Button text="Exportar XML parcheado" onAction="#onExportar"
                style="-fx-background-color: #fab387; -fx-text-fill: #1e1e2e;
                       -fx-font-weight: bold; -fx-background-radius: 6;
                       -fx-padding: 10 20; -fx-cursor: hand;"/>
        <Button text="Abrir en VS Code" onAction="#onAbrirDiff"
                style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e;
                       -fx-font-weight: bold; -fx-background-radius: 6;
                       -fx-padding: 10 20; -fx-cursor: hand;">
            <graphic>
                <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                    <image><Image url="@../img/vsCode.png"/></image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>

</VBox>