<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import java.net.URL?>

<StackPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.View.GestionPantallaController">
    <children>
        <VBox spacing="20" style="-fx-background-color: #1e1e2e; -fx-padding: 24;">
            
            <VBox spacing="10" alignment="CENTER">
                <Button text="▶  Iniciar Espejo de Pantalla"
                        onAction="#onLanzarScrcpy"
                        maxWidth="Infinity"
                        style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 15; -fx-background-radius: 10; -fx-cursor: hand;"/>
                <Separator opacity="0.1"/>
            </VBox>

            <VBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Resolución del Dispositivo" style="-fx-text-fill: #cdd6f4; -fx-font-weight: bold;"/>
                <HBox spacing="10" alignment="CENTER">
                    <ComboBox fx:id="comboResolucion" 
                             promptText="Seleccionar resolución..."
                             maxWidth="Infinity" HBox.hgrow="ALWAYS"
                             style="-fx-background-color: #313244; -fx-background-radius: 8; -fx-padding: 5; -fx-text-base-color: white; -fx-text-fill: white; -fx-prompt-text-fill: derive(white, -20%);">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="720x1280 (HD)" />
                                <String fx:value="1080x1920 (FHD 16:9)" />
                                <String fx:value="1080x2340 (FHD+ Moderno)" />
                                <String fx:value="1440x2560 (QHD)" />
                                <String fx:value="1440x3120 (WQHD+)" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                    <Button text="✓ Set" 
                            onAction="#cambiarResolucion"
                            style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Button text="Reset" 
                            onAction="#resetearResolucion"
                            style="-fx-background-color: #f5d59a; -fx-text-fill: #2e281e; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                </HBox>
                <Separator opacity="0.1"/>
            </VBox>

            <VBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Orientación y Vista" style="-fx-text-fill: #cdd6f4; -fx-font-weight: bold;"/>
                <HBox spacing="10">
                    <Button text="🔄 Rotar 90°" 
                            onAction="#rotarPantalla90"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Button text="↔ Simetría (Flip)" 
                            onAction="#flipPantalla"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
                </HBox>
                <Separator opacity="0.1"/>
            </VBox>

            <VBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Captura y Grabación" style="-fx-text-fill: #cdd6f4; -fx-font-weight: bold;"/>
                <HBox spacing="10">
                    <Button text="📸 Capturar Pantalla" 
                            onAction="#onCapturarPantalla"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
                </HBox>
                <HBox spacing="10">
                    <Button fx:id="btnIniciarGrabacion"
                            text="⏺ Iniciar Grabación" 
                            onAction="#onIniciarGrabacion"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #a6e3a1; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Button fx:id="btnDetenerGrabacion"
                            text="⏹ Detener" 
                            onAction="#onDetenerGrabacion"
                            disable="true"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #f38ba8; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
                </HBox>
                <Separator opacity="0.1"/>
            </VBox>
        </VBox>
        
        </children>
</StackPane>