<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: #2f3640;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.Controller.NuevoDispositivoController">
   <children>
      <Label text="REGISTRAR NUEVO EQUIPO" textFill="#00a8ff">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      
      <GridPane hgap="15.0" vgap="15.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="SERIAL:" textFill="WHITE" />
            <TextField fx:id="txtSerial" editable="false" style="-fx-background-color: #353b48; -fx-text-fill: #fbc531;" GridPane.columnIndex="1" />
            
            <Label text="MARCA:" textFill="WHITE" GridPane.rowIndex="1" />
            <ComboBox fx:id="cbMarca" prefWidth="250.0" promptText="Seleccione marca..." GridPane.rowIndex="1" GridPane.columnIndex="1" />
            
            <Label text="MODELO:" textFill="WHITE" GridPane.rowIndex="2" />
            <TextField fx:id="txtModelo" promptText="Ej: Galaxy S24" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            
            <Label text="PROCESADOR:" textFill="WHITE" GridPane.rowIndex="3" />
            <ComboBox fx:id="cbSoc" prefWidth="250.0" promptText="Seleccione SoC..." GridPane.rowIndex="3" GridPane.columnIndex="1" />
            <Label text="FOTO:" textFill="WHITE" GridPane.rowIndex="4" />
              <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                <children>
                <TextField fx:id="txtRutaFoto" editable="false" promptText="No seleccionada..." HBox.hgrow="ALWAYS" />
                 <Button onAction="#handleSeleccionarFoto" text="📁" />
   </children>
</HBox>

<Label text="BANDAS:" textFill="WHITE" GridPane.rowIndex="5" />
<TextField fx:id="txtBandas" promptText="Ej: 5G, LTE, B3 (Separadas por comas)" GridPane.columnIndex="1" GridPane.rowIndex="5" />

         </children>
      </GridPane>

      <HBox alignment="CENTER_RIGHT" spacing="15.0">
         <children>
            <Button onAction="#handleCancelar" style="-fx-background-color: #e84118; -fx-text-fill: white;" text="CANCELAR" />
            <Button onAction="#handleGuardar" style="-fx-background-color: #44bd32; -fx-text-fill: white; -fx-font-weight: bold;" text="GUARDAR DISPOSITIVO" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>