<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.Controller.MainController">
   
   <top>
      <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
         <children>
            <Label text="AEA MOBILE SUITE" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="btnEscanear" onAction="#handleEscanear" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;" text="DETECTAR EQUIPO (ADB)" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <center>
      <HBox alignment="CENTER" spacing="40.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <VBox alignment="TOP_CENTER" spacing="10.0" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-padding: 15;">
               <children>
                  <ImageView fx:id="imgDispositivo" fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
                  <Label text="Fotografía del Modelo" textFill="#7f8c8d" />
               </children>
            </VBox>

            <GridPane hgap="15.0" vgap="15.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="SERIAL:" GridPane.rowIndex="0">
                     <font> <Font name="System Bold" size="13.0" /> </font></Label>
                  <Label fx:id="lblSerial" text="Esperando..." textFill="#2980b9" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  
                  <Label text="MARCA:" GridPane.rowIndex="1">
                     <font> <Font name="System Bold" size="13.0" /> </font></Label>
                  <Label fx:id="lblMarca" text="---" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Label text="MODELO:" GridPane.rowIndex="2">
                     <font> <Font name="System Bold" size="13.0" /> </font></Label>
                  <Label fx:id="lblModelo" text="---" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  
                  <Label text="PROCESADOR:" GridPane.rowIndex="3">
                     <font> <Font name="System Bold" size="13.0" /> </font></Label>
                  <Label fx:id="lblSoC" text="---" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  
                  <Label text="ESTADO:" GridPane.rowIndex="4">
                     <font> <Font name="System Bold" size="13.0" /> </font></Label>
                  <Label fx:id="lblEstado" text="Desconectado" textFill="#e74c3c" GridPane.columnIndex="1" GridPane.rowIndex="4" />
               </children>
            </GridPane>
         </children>
      </HBox>
   </center>
   
   <bottom>
      <HBox alignment="CENTER_RIGHT" style="-fx-background-color: #ecf0f1; -fx-padding: 10;">
         <children>
            <Label text="Sistema de Ingeniería v1.0 - Bloque 1" textFill="#95a5a6" />
         </children>
      </HBox>
   </bottom>
</BorderPane>